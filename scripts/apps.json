    "html": "<div class=\"app-now\">当前时间戳：<strong id=\"ts-now\">—</strong> <button class=\"app-btn tiny\" data-act=\"useNow\">用当前时间</button></div>\n<textarea id=\"ts-in\" class=\"app-area\" rows=\"3\" placeholder=\"输入 10 位/13 位时间戳，或 2026-09-22 10:30:00\"></textarea>\n<div class=\"app-row\">\n  <button class=\"app-btn\" data-act=\"toDate\">时间戳 → 日期</button>\n  <button class=\"app-btn\" data-act=\"toTs\">日期 → 时间戳</button>\n</div>\n<textarea id=\"ts-out\" class=\"app-area\" rows=\"8\" readonly placeholder=\"结果\"></textarea>",
