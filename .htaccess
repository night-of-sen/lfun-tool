# 静态站点配置（Apache / LiteSpeed，Hostinger 共享主机适用）

DirectoryIndex index.html index.php
AddType application/json .json
AddDefaultCharset UTF-8

# 自定义 404
ErrorDocument 404 /404.html

# gzip 压缩
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# brotli（支持的浏览器用它，比 gzip 再小一截）
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml
</IfModule>

# 缓存：HTML 和 JSON 不缓存（改完刷新即生效），其他静态资源缓存 1 小时
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hours"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# 不对外暴露脚本、文档和 Git 元数据（站点本身不受影响）
<IfModule mod_alias.c>
  RedirectMatch 404 ^/scripts(/|$)
  RedirectMatch 404 ^/\.git(/|$)
  RedirectMatch 404 \.(md|mjs|ya?ml)$
</IfModule>

# www 与主域名同时可访问会被判定为重复内容，统一 301 到主域名
# 冗余的 index.html 同理：/index.html 和 / 是同一个页面，只保留一个 URL
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L,NE]

  RewriteCond %{THE_REQUEST} \s/+(.+)/index\.html[\s?] [NC]
  RewriteRule ^ /%1/ [R=301,L,NE]

  # 默认语言改为英文：旧的 /en/* 301 到 /*（英文内容已搬到根路径）
  RewriteRule ^en/(.*)$ /$1 [R=301,L]

  # P1 分类迁移：旧分类 301 到新主分类（根路径与 /zh/ 路径）
  RewriteRule ^category/(ai|agent|skill)/?$ /category/ai-agents/ [R=301,L]
  RewriteRule ^zh/category/(ai|agent|skill)/?$ /zh/category/ai-agents/ [R=301,L]
  RewriteRule ^category/(commerce|payment|finance|crm|support|notify|compliance|i18n)/?$ /category/business-support/ [R=301,L]
  RewriteRule ^zh/category/(commerce|payment|finance|crm|support|notify|compliance|i18n)/?$ /zh/category/business-support/ [R=301,L]
  RewriteRule ^category/(design|image|watermark|diagram)/?$ /category/design-creativity/ [R=301,L]
  RewriteRule ^zh/category/(design|image|watermark|diagram)/?$ /zh/category/design-creativity/ [R=301,L]
  RewriteRule ^category/(dev|editor|lowcode|devops)/?$ /category/dev-tools/ [R=301,L]
  RewriteRule ^zh/category/(dev|editor|lowcode|devops)/?$ /zh/category/dev-tools/ [R=301,L]
  RewriteRule ^category/(fun|game)/?$ /category/fun-games/ [R=301,L]
  RewriteRule ^zh/category/(fun|game)/?$ /zh/category/fun-games/ [R=301,L]
  RewriteRule ^category/(database|monitor|network|system|storage|security|auth)/?$ /category/infra-security/ [R=301,L]
  RewriteRule ^zh/category/(database|monitor|network|system|storage|security|auth)/?$ /zh/category/infra-security/ [R=301,L]
  RewriteRule ^category/(promo|email|social|analytics|experiment|sitesearch)/?$ /category/marketing-growth/ [R=301,L]
  RewriteRule ^zh/category/(promo|email|social|analytics|experiment|sitesearch)/?$ /zh/category/marketing-growth/ [R=301,L]
  RewriteRule ^category/(mobile|iot)/?$ /category/mobile-iot/ [R=301,L]
  RewriteRule ^zh/category/(mobile|iot)/?$ /zh/category/mobile-iot/ [R=301,L]
  RewriteRule ^category/(project|team|form|filesearch|utility|browser|download)/?$ /category/productivity/ [R=301,L]
  RewriteRule ^zh/category/(project|team|form|filesearch|utility|browser|download)/?$ /zh/category/productivity/ [R=301,L]
  RewriteRule ^category/(video|media|mediaserver|capture)/?$ /category/video-media/ [R=301,L]
  RewriteRule ^zh/category/(video|media|mediaserver|capture)/?$ /zh/category/video-media/ [R=301,L]
  RewriteRule ^category/(writing|doc|notes|learn)/?$ /category/writing-knowledge/ [R=301,L]
  RewriteRule ^zh/category/(writing|doc|notes|learn)/?$ /zh/category/writing-knowledge/ [R=301,L]

  # /go/<tool_id> 交给 PHP：302 跳转 + 记录点击（PRD 模块二）
  # 放过构建期兜底跳转表，它由静态文件直接提供
  RewriteCond %{REQUEST_URI} !^/go/affiliates\.json$
  RewriteRule ^go/([^/]+)/?$ /api/go.php?id=$1 [L,QSA]
</IfModule>


# 后端内部文件不允许直接访问
<IfModule mod_alias.c>
  RedirectMatch 404 ^/(config\.local[^/]*|api/lib/)
</IfModule>
